# sqlx / 애플리케이션이 실제로 사용하는 최종 연결 문자열
TEST_DATABASE_URL=postgres://axum_user:axum_password@localhost:15432/axum_test

# JWT 테스트용
JWT_SECRET=굿바이-키미노-운메이노-히토와-보쿠쟈나이
JWT_ACCESS_TOKEN_EXPIRES_IN_SECONDS=120
# REFRESH_TOKEN_EXPIRES_IN_SECONDS=600

# Key-Value Store
CACHE_BACKEND=redis

REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=axum_password
REDIS_DB=1

DRAGONFLY_HOST=localhost
DRAGONFLY_PORT=16380
DRAGONFLY_PASSWORD=axum_password
DRAGONFLY_DB=1