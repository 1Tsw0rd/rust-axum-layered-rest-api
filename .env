# PostgreSQL 데이터베이스 계정 정보
DB_USER=axum_user
DB_PASSWORD=axum_password
DB_HOST=localhost
DB_PORT=15432
DB_NAME=axum_db

# sqlx / 애플리케이션이 실제로 사용하는 최종 연결 문자열
DATABASE_URL=postgres://axum_user:axum_password@localhost:15432/axum_db

# 로그 레벨: sqlx는 debug 레벨에서 SQL 쿼리 로그가 출력되므로 warn으로 제한
RUST_LOG=my_app=debug,tower_http=debug,sqlx=warn

# JWT
JWT_SECRET=Fear_Is_The_Seed_Of_Courage
JWT_ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
# REFRESH_TOKEN_EXPIRES_IN_SECONDS=259200

# Key-Value Store
# CACHE_BACKEND로 redis 또는 dragonfly 둘 중에 하나 선택 가능
CACHE_BACKEND=redis

REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=axum_password
REDIS_DB=0

DRAGONFLY_HOST=localhost
DRAGONFLY_PORT=16380
DRAGONFLY_PASSWORD=axum_password
DRAGONFLY_DB=0